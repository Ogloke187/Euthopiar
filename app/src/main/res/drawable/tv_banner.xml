<?xml version="1.0" encoding="utf-8"?>
<!-- Leanback launcher banner (320x180). Required for LEANBACK_LAUNCHER tiles.
     Save as: app/src/main/res/drawable/tv_banner.xml
     Vector so no PNG asset is needed. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0B0B0F" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="24dp" android:right="24dp" android:top="52dp" android:bottom="52dp">
        <shape android:shape="rectangle">
            <solid android:color="#E50914" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>
